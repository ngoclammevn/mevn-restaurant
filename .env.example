# Tất cả đều là publishable/public key — KHÔNG để service_role hay Clerk secret ở đây.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# URL gốc của Cloudflare Worker, ví dụ https://ten-worker.workers.dev
# Không có API key bí mật ở frontend; dùng token đăng nhập Clerk đang có.
VITE_AI_API_BASE_URL=
# Server-side only (Vercel env vars, không có tiền tố VITE_)
GEMINI_API_KEY=
